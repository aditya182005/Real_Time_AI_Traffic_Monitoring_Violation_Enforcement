# Copy to .env and fill in. Leave blank to skip SMS alerts.
# Check your setup with:  python -m app.alerts.twilio_alert --send
#
# Account SID (starts with AC) and Auth Token: Twilio Console home page.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number, international format, e.g. +14155550123
TWILIO_PHONE_NUMBER=
# Who to alert, international format. Trial accounts: must be verified.
ALERT_TO_PHONE=

# Also place a voice call (not just an SMS) for each collision: true / false.
ALERT_VOICE_CALL=false

# Camera name stored with records and included in collision alerts.
CAMERA_ID=CAM-01

# --- Deploying (see docs/DEPLOYMENT.md) ---------------------------------------------
# Password for the dashboard. Leave blank on your own computer.
DASHBOARD_PASSWORD=
# Set to production on a server: the app then refuses to start without a
# dashboard password.
APP_ENV=
# Keep the database and all generated files here instead of the project
# folder (the Docker image uses /data).
TRAFFIC_AGENT_DATA_DIR=
# Delete uploaded-run folders older than this many days. 0 keeps everything.
UPLOAD_RETENTION_DAYS=0

# --- Who can sign in (see docs/DEPLOYMENT.md) --------------------------------------
# users: individual accounts   (python -m app.users add NAME --role admin)
# password: one shared password (DASHBOARD_PASSWORD above)
# proxy: an identity-aware proxy passes the user's email in a header
# Leave blank to detect: accounts if a users file exists, else the password.
AUTH_MODE=
# Role everyone gets with the shared password: viewer, operator or admin.
DASHBOARD_PASSWORD_ROLE=operator
# Where accounts are stored (default: users.json in the data folder).
USERS_FILE=
# Proxy mode only:
AUTH_PROXY_HEADER=X-Forwarded-Email
AUTH_PROXY_ADMINS=
AUTH_PROXY_OPERATORS=
AUTH_PROXY_DEFAULT_ROLE=viewer

# --- Live cameras ------------------------------------------------------------
# Name=address pairs separated by semicolons. On a server only these can be
# used. Addresses often contain a camera password: keep this file private.
LIVE_CAMERAS=
# Allow typing any address on a production server (off by default).
LIVE_ALLOW_CUSTOM=false
# How many cameras may be analyzed at the same time (each needs CPU/GPU).
LIVE_MAX_CAMERAS=1

# --- License plates (needs requirements/plates.txt) ------------------------
# IN applies the Indian plate format when cleaning OCR text; ANY does not.
PLATE_REGION=IN
# Set to off to disable plate reading even if EasyOCR is installed.
PLATE_OCR=

# --- Logging ------------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR. Logs go to the console and to
# logs/traffic_agent.log in the data folder.
LOG_LEVEL=INFO

# --- Production settings (see docs/PRODUCTION.md) ----------------------------
# JSON file with your fine amounts (see deploy/fines.example.json). Blank uses
# the demo amounts.
FINES_FILE=
# JSON file of per-camera calibration (see deploy/cameras.example.json).
CAMERAS_FILE=
# Delete evidence images, crops and plate text older than this many days.
# 0 keeps everything.
EVIDENCE_RETENTION_DAYS=0
# Label stored with each violation for the models in use. Blank builds one
# from the model files.
MODEL_VERSION=
# Confidence needed to call something an emergency vehicle (0.05 to 0.99).
# Raise it (0.85) if ordinary trucks or cars are flagged; lower it if real
# emergency vehicles are missed. Default 0.65.
EMERGENCY_CONFIDENCE=
