# Copy to .env and fill in. Leave blank to skip SMS alerts.
# Check your setup with:  python -m app.alerts.twilio_alert --send
#
# Account SID (starts with AC) and Auth Token: Twilio Console home page.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number, international format, e.g. +14155550123
TWILIO_PHONE_NUMBER=
# Who to alert, international format. Trial accounts: must be verified.
ALERT_TO_PHONE=

# Also place a voice call (not just an SMS) for each collision: true / false.
ALERT_VOICE_CALL=false

# Camera name stored with records and included in collision alerts.
CAMERA_ID=CAM-01
